# Rust source and lock files must remain LF so rustfmt --check passes on all OS.
*.rs text eol=lf
Cargo.lock text eol=lf

# Asset files must stay LF so SHA-256 hashes in manifest.yml are stable across platforms.
assets/**/*.yml text eol=lf
assets/**/*.json text eol=lf
assets/**/*.md text eol=lf

# CI scripts and workflow files must stay LF so bash runners execute them correctly.
scripts/ci/*.sh text eol=lf
scripts/ci/*.ps1 text eol=lf
.github/workflows/*.yml text eol=lf

# Golden snapshots must stay LF so parity compares match process stdout on all OS.
tests/golden/** text eol=lf

# npm init templates are synced byte-for-byte from the published package (LF).
assets/npm/** -text

# npm `dare init` parity goldens (cycle rust-init-npm-parity-011): byte-stable, never normalized.
crates/dare-cli/tests/fixtures/golden/init-npm/** -text

# Parity generator + command shims: LF for POSIX shims/scripts, CRLF for Windows .cmd shims.
scripts/parity/*.mjs text eol=lf
scripts/parity/*.sh text eol=lf
scripts/parity/*.ps1 text eol=lf
scripts/parity/shims/* text eol=lf
scripts/parity/shims/*.cmd text eol=crlf
