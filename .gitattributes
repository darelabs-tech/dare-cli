# Rust source and lock files must remain LF so rustfmt --check passes on all OS.
*.rs text eol=lf
Cargo.lock text eol=lf

# Asset files must stay LF so SHA-256 hashes in manifest.yml are stable across platforms.
assets/**/*.yml text eol=lf
assets/**/*.json text eol=lf
assets/**/*.md text eol=lf

# CI scripts and workflow files must stay LF so bash runners execute them correctly.
scripts/ci/*.sh text eol=lf
scripts/ci/*.ps1 text eol=lf
.github/workflows/*.yml text eol=lf

# Golden snapshots must stay LF so parity compares match process stdout on all OS.
tests/golden/** text eol=lf
